# === Bancos de Dados — Auth Service ===
POSTGRES_AUTH_USER=auth_user
POSTGRES_AUTH_PASSWORD=change_me_auth
POSTGRES_AUTH_DB=authdb

# === Bancos de Dados — Chat Service ===
POSTGRES_CHAT_USER=chat_user
POSTGRES_CHAT_PASSWORD=change_me_chat
POSTGRES_CHAT_DB=chatdb

# === Redis ===
REDIS_PASSWORD=change_me_redis

# === JWT (compartilhado entre Auth e Chat Service) ===
# Gere um valor seguro: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_jwt_secret_must_be_long_and_random
JWT_EXPIRE_MINUTES=10080

# === Portas expostas no host (desenvolvimento) ===
POSTGRES_AUTH_HOST_PORT=5432
POSTGRES_CHAT_HOST_PORT=5433
REDIS_HOST_PORT=6379
AUTH_SERVICE_HOST_PORT=8000
CHAT_SERVICE_1_HOST_PORT=8001
CHAT_SERVICE_2_HOST_PORT=8002
FRONTEND_HOST_PORT=5173
